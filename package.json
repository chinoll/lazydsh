{
  "name": "lazydsh",
  "version": "0.1.1",
  "description": "A personally maintained plugin for DeepSeek Harness.",
  "license": "GPL-3.0-only",
  "author": "chinoll",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "src/",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.2-rc.3 <0.2.3-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && npm test && npm run build",
    "prepack": "npm run check",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chinoll/lazydsh.git"
  },
  "homepage": "https://github.com/chinoll/lazydsh#readme",
  "bugs": {
    "url": "https://github.com/chinoll/lazydsh/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.3",
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.25.0",
    "immer": "^10.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  }
}
