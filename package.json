{
  "name": "lazydsh",
  "version": "0.2.2",
  "description": "A personally maintained plugin for DeepSeek Harness.",
  "license": "GPL-3.0-only",
  "author": "chinoll",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./gemini": "./src/providers/gemini/index.js"
  },
  "files": [
    "src/",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "vendor/",
    "scripts/build-client.mjs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.2-rc.3 <0.2.3-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-attachment": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check src/index.js && node --check src/providers/gemini/index.js && npm run build",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chinoll/lazydsh.git"
  },
  "homepage": "https://github.com/chinoll/lazydsh#readme",
  "bugs": {
    "url": "https://github.com/chinoll/lazydsh/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
